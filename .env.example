# Owner deployer key (the wallet that holds the 10 test BOT).
# Never commit this file as .env. Hex keys need a 0x prefix.
PRIVATE_KEY=0x

# Agent EOA — separate from the owner. Holds a little BOT for gas only.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=0x

# Filled after deploy.
RAIL_ADDRESS=
PAYEE_ADDRESS=

# Caps in wei (1 BOT = 1e18). Defaults: 0.5 per tx, 2 per UTC day.
PER_TX_CAP_WEI=500000000000000000
DAILY_CAP_WEI=2000000000000000000
